# FeedbackAI frontend — optional overrides only. Never put Groq or other API secrets here.
# Optional: override API origin when not using the Vite dev/preview proxy (e.g. production static hosting).
# Leave unset during local dev so requests use same-origin /api and the proxy in vite.config.ts.
# VITE_API_BASE_URL=http://127.0.0.1:5047

# Optional: change where the dev server proxies /api (default http://127.0.0.1:5047).
# VITE_DEV_API_PROXY=http://127.0.0.1:5047